C4Container
    title Dailies Ingest Platform — Containers
    Person(p_dit, "DIT / Data Wrangler", "Loads cards at the cart.")
    Container(c_edge, "Edge Tier", "WAF + managed load balancer", "Mandated termination point for external traffic.")
    System_Ext(s_mam, "Existing MAM", "Incumbent asset manager; not being replaced.")
    Container(c_prefetch, "Prefetch Cache", "Redis", "Speculative: only needed if post requires sub-minute handoff.")
    Container(c_api, "Ingest API", "Python 3.11 / FastAPI", "Accepts card submissions without operator interaction.")
    Container(c_queue, "Replay Buffer", "Kafka", "Durable event log enabling replay after an outage.")
    Container(c_telemetry, "Telemetry Sidecar", "OpenTelemetry collector", "Emits to the central pipeline.")
    Container(c_audit, "Audit Ledger", "PostgreSQL, append-only", "Durable record of every asset movement.")
    Container(c_worker, "Handoff Worker", "Python", "Drains the buffer into the MAM.")
    Rel(p_dit, c_edge, "submits dailies")
    Rel(c_edge, c_api, "forwards")
    Rel(c_api, c_queue, "publishes events")
    Rel(c_api, c_audit, "writes audit record")
    Rel(c_api, c_prefetch, "reads")
    Rel(c_api, c_telemetry, "emits metrics")
    Rel(c_queue, c_worker, "delivers")
    Rel(c_worker, s_mam, "hands off assets")
