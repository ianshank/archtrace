  "decisions": [
    {
      "id": "ADR-001",
      "title": "Buffer and replay rather than retry in place",
      "status": "accepted",
      "drivers": [
        "REQ-001"
      ],
      "decision": "Events land in a durable log; a separate worker drains it, so a four-hour outage is a backlog rather than a loss.",
      "consequences": "Introduces a worker and a buffer that no stakeholder asked for; both are grounded as derived from this decision, not as requirements."
    }
