{
  "schema_version": 1,
  "decisions": [
    {
      "id": "ADR-001",
      "title": "A human confirms every requirement",
      "status": "accepted",
      "drivers": [
        "REQ-007"
      ],
      "decision": "Promotion from proposed to confirmed is a human git commit.",
      "consequences": "Nobody asked for this step; it is the only control for a plausible-but-wrong requirement carrying a real quote."
    },
    {
      "id": "ADR-002",
      "title": "Approval binds to content hashes, not a commit",
      "status": "accepted",
      "drivers": [
        "REQ-004"
      ],
      "decision": "release.json records approver, commit and a SHA-256 per source and output; --verify reports MATCH or DRIFT.",
      "consequences": "Nobody asked for this; it came from a peer review finding that a commit does not prove which artifact was approved."
    },
    {
      "id": "ADR-003",
      "title": "The repository holds claims about evidence, never the content",
      "status": "accepted",
      "drivers": [
        "REQ-001"
      ],
      "decision": "Normalise and hash at intake; the manifest is committed, the content stays in the system of record.",
      "consequences": "Nobody asked for this; a repository cannot satisfy a retention obligation."
    },
    {
      "id": "ADR-004",
      "title": "Retrieved documents are data, never instructions",
      "status": "accepted",
      "drivers": [
        "REQ-006"
      ],
      "decision": "Every agent contract carries the rule; no pattern detector, because it is trivially evaded.",
      "consequences": "Nobody asked for this; it came from a peer review finding about indirect prompt injection."
    }
  ],
